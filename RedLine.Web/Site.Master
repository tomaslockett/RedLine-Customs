<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="RedLine.Web.SiteMaster" %>

<!DOCTYPE html>
<html lang="es">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - RedLine Customs</title>

    <link href="~/Content/Master.css" rel="stylesheet" runat="server" />
</head>
<body>
    <form runat="server">

        <asp:ScriptManager ID="smGlobal" runat="server"></asp:ScriptManager>

        <header class="cabecera-principal">
            
            <div class="contenedor-marca">
                <div class="caja-icono-marca">
                    <img src="<%= ResolveUrl("~/Content/img/lupita.png") %>" alt="Icono RedLine" /> 
                </div>
                <div class="texto-marca">
                    <h1>REDLINE CUSTOMS</h1>
                    <span>30 años de excelencia</span>
                </div>
            </div>

            <nav class="contenedor-navegacion">
                
                <a runat="server" href="~/Catalogo" class="boton-menu boton-texto-simple">
                    <img src="<%= ResolveUrl("~/Content/img/lupita.png") %>" alt="Inicio" />
                    Inicio
                </a>

                <a runat="server" href="~/CrearAutos.aspx" class="boton-menu boton-contorno-rojo">
                    <img src="<%= ResolveUrl("~/Content/img/lupita.png") %>" alt="Crear Auto" />
                    Crear Auto
                </a>

                <a runat="server" href="~/Inventario.aspx" class="boton-menu boton-texto-simple">
                    <img src="<%= ResolveUrl("~/Content/img/lupita.png") %>" alt="Inventario" />
                    Inventario
                </a>

                <a runat="server" href="~/GestionEventos.aspx" class="boton-menu boton-texto-simple">
                    <img src="<%= ResolveUrl("~/Content/img/lupita.png") %>" alt="Eventos" />
                    Gestion Eventos
                </a>

                <a runat="server" href="~/GestionUsuarios.aspx" class="boton-menu boton-texto-simple">
                    <img src="<%= ResolveUrl("~/Content/img/lupita.png") %>" alt="Usuarios" />
                    Gestion Usuarios
                </a>

                <a runat="server" href="~/GestionClientes.aspx" class="boton-menu boton-texto-simple">
                     <img src="<%= ResolveUrl("~/Content/img/lupita.png") %>" alt="Clientes" />
                     Gestion Clientes
                </a>

                <a runat="server" href="~/HistorialVentas.aspx" class="boton-menu boton-texto-simple">
                    <img src="<%= ResolveUrl("~/Content/img/lupita.png") %>" alt="Ventas" />
                    Historial de Ventas
                </a>

                <a runat="server" href="~/RegistroCliente.aspx" class="boton-menu boton-texto-simple">
                    <img src="<%= ResolveUrl("~/Content/img/lupita.png") %>" alt="Cliente" />
                    Registrarse
                </a>

                <a runat="server" href="~/CambioContraseña.aspx" class="boton-menu boton-texto-simple">
                    <img src="<%= ResolveUrl("~/Content/img/lupita.png") %>" alt="Contraseña" />
                    Cambio Contraseña
                </a>

                <a runat="server" href="~/LogIn.aspx" class="boton-menu boton-solido-rojo">
                    <img src="<%= ResolveUrl("~/Content/img/lupita.png") %>" alt="Login" />
                    Iniciar Sesión
                </a>

            </nav>
        </header>

        <main class="contenedor-principal">

            <asp:ContentPlaceHolder ID="MainContent" runat="server"> </asp:ContentPlaceHolder>
            
            <footer class="pie-pagina">
                <p>&copy; 2026 - RedLine Customs</p>
            </footer>
        </main>

    </form>
</body>
</html>